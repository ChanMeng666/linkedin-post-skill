%% Example of content that belongs in Mermaid (references/visuals.md §2): a loop.
%% The arrow going back from review to the brief is the point; take it away and the
%% meaning is gone. Six nodes, short labels, one accent.
%% No `--- config ---` block: the brand theme is applied by scripts/render-mermaid.mjs.
flowchart TB
    GOAL["Set the goal"]:::ink --> DONE["Define 'done'"]
    DONE --> DRAFT["Model drafts"]
    DRAFT --> REVIEW{"You review"}:::accent
    REVIEW -- "not right" --> BRIEF["Sharpen the brief"]
    BRIEF --> DRAFT
    REVIEW -- "meets 'done'" --> SHIP["Ship"]:::ink

    classDef accent  fill:#FC5000,stroke:#070607,color:#fff;
    classDef ink     fill:#070607,stroke:#070607,color:#fff;
    classDef glare   fill:#F5F28E,stroke:#070607,color:#070607;
    classDef surface fill:#F7F6F2,stroke:#070607,color:#070607;
